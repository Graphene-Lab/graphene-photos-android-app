<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keystore wrapping keys are device-bound and cannot accompany these files on restore. -->
    <exclude domain="sharedpref" path="secret_shared_prefs.xml" />
    <exclude domain="sharedpref" path="encrypted_session_prefs.xml" />
    <exclude domain="sharedpref" path="secure_app_settings.xml" />
    <!-- Older builds could write session secrets to this fallback file. -->
    <exclude domain="sharedpref" path="encrypted_session_prefs_fallback.xml" />
</full-backup-content>
